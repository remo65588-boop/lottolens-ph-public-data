{
  "profile": "tabular-data-package",
  "name": "philippines-pcso-schedule-and-historical-results",
  "title": "Philippines PCSO Draw Schedule and Historical Results Snapshot",
  "description": "Normal draw schedules and a 13,457-row independently compiled historical results snapshot with row-level provenance for nine PCSO digit and jackpot games.",
  "version": "2.0.0",
  "homepage": "https://lottolensph.com/research/pcso-results-data-coverage",
  "id": "https://doi.org/10.6084/m9.figshare.33183167.v1",
  "licenses": [
    {
      "name": "CC-BY-4.0",
      "path": "https://creativecommons.org/licenses/by/4.0/",
      "title": "Creative Commons Attribution 4.0 International"
    }
  ],
  "sources": [
    {
      "title": "Philippine Charity Sweepstakes Office",
      "path": "https://www.pcso.gov.ph/"
    }
  ],
  "contributors": [
    {
      "title": "LottoLens PH Editorial",
      "role": "publisher",
      "path": "https://lottolensph.com/"
    }
  ],
  "keywords": [
    "Philippines",
    "PCSO",
    "lottery draw schedule",
    "2D Lotto",
    "3D Lotto",
    "4D Lotto",
    "6D Lotto",
    "historical lottery results",
    "open data"
  ],
  "resources": [
    {
      "profile": "tabular-data-resource",
      "name": "pcso-draw-schedule",
      "path": "data/pcso-draw-schedule.csv",
      "title": "PCSO draw schedule",
      "description": "Normal draw days, times, result formats, official source, and LottoLens PH reference pages.",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          { "name": "game_slug", "type": "string" },
          { "name": "game_name", "type": "string" },
          { "name": "game_type", "type": "string", "constraints": { "enum": ["digit", "jackpot"] } },
          { "name": "result_format", "type": "string" },
          { "name": "normal_draw_days", "type": "string" },
          { "name": "normal_draw_times_pht", "type": "string" },
          { "name": "timezone", "type": "string" },
          { "name": "official_source", "type": "string", "format": "uri" },
          { "name": "reference_page", "type": "string", "format": "uri" }
        ],
        "primaryKey": "game_slug"
      }
    },
    {
      "profile": "tabular-data-resource",
      "name": "verified-pcso-draw-results-snapshot",
      "path": "data/verified-pcso-draw-results-snapshot.csv",
      "title": "Historical PCSO draw results snapshot",
      "description": "Independently compiled historical result rows with draw date, time, winning numbers, publication status, and row-level source provenance. Snapshot published 2026-08-07.",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          { "name": "lottery_slug", "type": "string" },
          { "name": "draw_date", "type": "date", "format": "%Y-%m-%d" },
          { "name": "draw_time", "type": "string" },
          { "name": "winning_numbers", "type": "string" },
          { "name": "jackpot_amount", "type": "number" },
          { "name": "status", "type": "string", "constraints": { "enum": ["published"] } },
          { "name": "published_at", "type": "datetime" },
          { "name": "source_name", "type": "string" },
          { "name": "source_url", "type": "string", "format": "uri" }
        ],
        "primaryKey": ["lottery_slug", "draw_date", "draw_time"]
      }
    },
    {
      "profile": "tabular-data-resource",
      "name": "field-definitions",
      "path": "data/field-definitions.csv",
      "title": "Field definitions",
      "description": "Human-readable definitions for fields in the schedule and historical-results resources.",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          { "name": "field", "type": "string" },
          { "name": "definition", "type": "string" }
        ],
        "primaryKey": "field"
      }
    }
  ]
}
